# TAS Auto Completion Assistant — Environment Variables

# Base URL of the TAS system
TAS_BASE_URL=https://tas.vghtpe.gov.tw/tas/

# LLM provider: gemini | openai | anthropic
LLM_PROVIDER=gemini

# API key for the chosen LLM provider
LLM_API_KEY=your-api-key-here

# Model name (e.g., gemini-2.5-flash for Gemini free tier)
LLM_MODEL=gemini-2.5-flash

# Set to 1 to enable dry-run mode (log actions but don't fill forms)
DRY_RUN=0

# Playwright browser data directory (for persistent login sessions)
BROWSER_DATA_DIR=./browser_data

# Web UI port
UI_PORT=8550
